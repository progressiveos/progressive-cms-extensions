{
  "id": "progressive-media.unsplash",
  "name": "Progressive Media — Unsplash",
  "version": "1.0.4",
  "extension_contract": "2.0",
  "cms_compatibility": ">=1.0.0-rc.1 <2.0.0",
  "requires": [],
  "provides": [],
  "permissions": [
    "media.stock.search",
    "media.stock.import",
    "media.providers.manage"
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "access_key": {
        "type": "object",
        "format": "secret-ref"
      },
      "network": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "direct",
              "socks5",
              "direct_then_socks5"
            ]
          },
          "proxy_host": {
            "type": "string",
            "maxLength": 255
          },
          "proxy_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "remote_dns": {
            "type": "boolean"
          },
          "proxy_username": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "proxy_password": {
        "type": "object",
        "format": "secret-ref"
      }
    }
  },
  "data_policy": "retain",
  "entrypoint": {
    "type": "module"
  },
  "registrations": {
    "providers": [
      {
        "registry": "media_stock_provider",
        "provider_id": "unsplash",
        "title": "Unsplash",
        "handler": "createStockProvider"
      }
    ]
  },
  "description": {
    "ru": "Стоковые фото Unsplash для медиатеки",
    "en": "Unsplash stock photos for the media library"
  },
  "icon": "media"
}
